@inject AuthStateService Auth
@inject QueueMatchmakingService Matchmaking
@inject ResumableMatchService Resumable

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found - BattleGrid</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="not-found-page">
                <div class="radar-ping"></div>
                <h1>404</h1>
                <p class="muted">Grid coordinate not found.</p>
                <a href="/" class="btn btn-primary">Return to Base</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Auth.InitializeAsync();
        if (Auth.IsLoggedIn)
            await Resumable.RefreshAsync();
        await Matchmaking.TryResumeFromStoredIntentAsync();
        await InvokeAsync(StateHasChanged);
    }
}