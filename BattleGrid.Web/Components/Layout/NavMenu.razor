@implements IDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject ActiveMatchSession MatchSession
@inject QueueMatchmakingService Matchmaking
@inject ResumableMatchService Resumable

<nav class="navbar">
    <a href="/" class="navbar-brand">
        <span class="brand-icon">⬡</span>
        <span class="brand-text">BATTLE<span class="brand-accent">GRID</span></span>
    </a>

    <div class="navbar-links">
        @if (MatchSession.IsLocked)
        {
            <span class="nav-link nav-locked">MATCH IN PROGRESS</span>
        }
        else
        {
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">HOME</NavLink>
            <NavLink href="/shiptypes" class="nav-link">FLEET</NavLink>
            <NavLink href="/leaderboard" class="nav-link">LEADERBOARD</NavLink>
        }

        @if (Auth.IsLoggedIn)
        {
            @if (!MatchSession.IsLocked)
            {
                @if (Resumable.HasResumableMatch && Resumable.MatchId is int navMatchId)
                {
                    <NavLink href="@($"/game/{navMatchId}")" class="nav-link nav-queue-link">REJOIN MATCH</NavLink>
                }
                else
                {
                    <NavLink href="/queue" class="nav-link nav-queue-link">
                        @(Matchmaking.IsInQueue ? "IN QUEUE" : "FIND MATCH")
                        @if (Matchmaking.IsInQueue && Matchmaking.QueueStartedUtc is not null)
                        {
                            <span class="nav-queue-timer">@QueueMatchmakingService.FormatWaitClock(Matchmaking.GetQueueElapsed())</span>
                        }
                    </NavLink>
                }
            }

            @if (_userMenuOpen)
            {
                <button type="button" class="nav-dropdown-backdrop" aria-label="Close menu" @onclick="CloseMenus"></button>
            }

            <div class="nav-dropdown">
                <button type="button"
                        class="nav-user nav-user-trigger"
                        aria-expanded="@_userMenuOpen"
                        aria-haspopup="true"
                        @onclick="ToggleUserMenu"
                        @onclick:stopPropagation="true">
                    <span class="status-dot online"></span>
                    @(string.IsNullOrWhiteSpace(Auth.CurrentUser?.UserName) ? "-" : Auth.CurrentUser!.UserName)
                    @if (Auth.CurrentUser?.IsAdmin == true)
                    {
                        <span class="badge badge-admin">ADMIN</span>
                    }
                    <span class="nav-user-chevron @(_userMenuOpen ? "is-open" : "")" aria-hidden="true">▾</span>
                </button>

                @if (_userMenuOpen)
                {
                    <div class="nav-dropdown-menu" @onclick:stopPropagation="true">
                        @if (!MatchSession.IsLocked)
                        {
                            <NavLink href="/dashboard" class="nav-dropdown-item" @onclick="CloseMenus">DASHBOARD</NavLink>
                            <NavLink href="/match-history" class="nav-dropdown-item" @onclick="CloseMenus">MATCH HISTORY</NavLink>
                            <NavLink href="/settings" class="nav-dropdown-item" @onclick="CloseMenus">SETTINGS</NavLink>                            

                            @if (Auth.CurrentUser?.IsAdmin == true)
                            {
                                <div class="nav-dropdown-submenu">
                                    <button type="button"
                                            class="nav-dropdown-item nav-dropdown-submenu-trigger"
                                            aria-expanded="@_adminSubmenuOpen"
                                            @onclick="ToggleAdminSubmenu">
                                        COMMAND
                                        <span class="nav-submenu-chevron @(_adminSubmenuOpen ? "is-open" : "")" aria-hidden="true">▸</span>
                                    </button>
                                    @if (_adminSubmenuOpen)
                                    {
                                        <div class="nav-dropdown-submenu-panel">
                                            <NavLink href="/admin" class="nav-dropdown-item nav-dropdown-subitem" @onclick="CloseMenus">ADMIN PANEL</NavLink>
                                            <NavLink href="/users" class="nav-dropdown-item nav-dropdown-subitem" @onclick="CloseMenus">PERSONNEL</NavLink>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="nav-dropdown-divider"></div>
                        }

                        <button type="button"
                                class="nav-dropdown-item nav-dropdown-item-danger"
                                disabled="@MatchSession.IsLocked"
                                title="@(MatchSession.IsLocked ? "Leave the match from the game screen." : null)"
                                @onclick="Logout">
                            LOGOUT
                        </button>
                    </div>
                }
            </div>
        }
        else if (!MatchSession.IsLocked)
        {
            <NavLink href="/register" class="btn btn-sm btn-primary nav-btn">REGISTER</NavLink>
            <NavLink href="/login" class="btn btn-sm btn-outline nav-btn">LOGIN</NavLink>            
        }
    </div>
</nav>

@code {
    bool _userMenuOpen;
    bool _adminSubmenuOpen;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
        MatchSession.OnChange += OnMatchSessionChanged;
        Matchmaking.OnStateChanged += OnMatchmakingChanged;
        Resumable.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Auth.IsLoggedIn)
            return;

        await Resumable.RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    void OnMatchSessionChanged() => _ = InvokeAsync(StateHasChanged);

    void OnMatchmakingChanged() => _ = InvokeAsync(StateHasChanged);

    void ToggleUserMenu()
    {
        _userMenuOpen = !_userMenuOpen;
        if (!_userMenuOpen)
            _adminSubmenuOpen = false;
    }

    void ToggleAdminSubmenu() => _adminSubmenuOpen = !_adminSubmenuOpen;

    void CloseMenus()
    {
        _userMenuOpen = false;
        _adminSubmenuOpen = false;
    }

    async Task Logout()
    {
        if (MatchSession.IsLocked)
        {
            // Avoid orphaning an active match from the nav bar; use in-game Leave.
            return;
        }

        CloseMenus();
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
        MatchSession.OnChange -= OnMatchSessionChanged;
        Matchmaking.OnStateChanged -= OnMatchmakingChanged;
        Resumable.OnChange -= StateHasChanged;
    }
}