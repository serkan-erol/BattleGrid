@page "/dashboard"
@implements IAsyncDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject ApiService Api
@inject QueueMatchmakingService Matchmaking
@inject ResumableMatchService Resumable
@inject IJSRuntime JS

<PageTitle>Dashboard - BattleGrid</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="loading-screen">
        <p class="muted">Restoring session...</p>
    </div>
}
else if (!Auth.IsLoggedIn)
{
    <div class="loading-screen">
        <p class="muted">Redirecting to login...</p>
    </div>
}
else
{
    <div class="page-header">
        <h1><span class="accent">◈</span> COMMAND DASHBOARD</h1>
        <p class="muted">Operator session active</p>
    </div>

    <div class="cards-grid">
        <div class="card card-accent">
            <div class="card-header">
                <span class="card-icon">👤</span>
                <span class="card-label">OPERATOR PROFILE</span>
            </div>
            <div class="card-body">
                <table class="info-table">
                    <tr>
                        <td class="info-key">USER ID</td>
                        <td class="info-val">#@Auth.CurrentUser!.UserID</td>
                    </tr>
                    <tr>
                        <td class="info-key">USERNAME</td>
                        <td class="info-val">@ResolveShownUsername()</td>
                    </tr>
                    <tr>
                        <td class="info-key">EMAIL</td>
                        <td class="info-val">@Auth.CurrentUser.Email</td>
                    </tr>
                    <tr>
                        <td class="info-key">ROLE</td>
                        <td class="info-val">
                            @if (Auth.CurrentUser.IsAdmin)
                            {
                                <span class="badge badge-admin">ADMIN</span>
                            }
                            else
                            {
                                <span class="badge badge-player">PLAYER</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="info-key">STATUS</td>
                        <td class="info-val">
                            <OperatorAccountStatus User="Auth.CurrentUser" BanStatus="_banStatus" />
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-icon">📊</span>
                <span class="card-label">PLAYER SEASON STATS</span>
            </div>
            <div class="card-body">
                @if (!_seasonStatsLoaded)
                {
                    <p class="muted">Loading season stats…</p>
                }
                else if (_seasonStatsError is { } err)
                {
                    <p class="muted">@err</p>
                }
                else if (_seasonStats is { } s)
                {
                    <table class="info-table">
                        <tr>
                            <td class="info-key">SEASON</td>
                            <td class="info-val">#@s.SeasonNo</td>
                        </tr>
                        <tr>
                            <td class="info-key">RATING</td>
                            <td class="info-val">@s.Rating</td>
                        </tr>
                        <tr>
                            <td class="info-key">SEASON PEAK</td>
                            <td class="info-val">@s.HighestRating</td>
                        </tr>
                        <tr>
                            <td class="info-key">PLAYED</td>
                            <td class="info-val">@s.MatchesPlayed</td>
                        </tr>
                        <tr>
                            <td class="info-key">WON</td>
                            <td class="info-val">@s.MatchesWon</td>
                        </tr>
                        <tr>
                            <td class="info-key">LOST</td>
                            <td class="info-val">@(s.MatchesPlayed - s.MatchesWon)</td>
                        </tr>
                        <tr>
                            <td class="info-key">WIN RATE</td>
                            <td class="info-val">@s.WinRate.ToString("0.##")%</td>
                        </tr>
                        @if (s.LastUpdatedAt is { } lu)
                        {
                            <tr>
                                <td class="info-key">LAST UPDATED</td>
                                <td class="info-val muted">@lu.UtcDateTime.ToString("yyyy-MM-dd HH:mm UTC")</td>
                            </tr>
                        }
                    </table>
                }
                else
                {
                    <p class="muted">No season stats available.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-icon">⚓</span>
                <span class="card-label">QUICK ACTIONS</span>
            </div>
            <div class="card-body quick-actions">
                @if (Resumable.HasResumableMatch && Resumable.MatchId is int mid)
                {
                    <p class="muted">You have a match in progress - rejoin to continue.</p>
                    <a href="/game/@mid" class="btn btn-primary btn-full">REJOIN MATCH #@mid</a>
                }
                else
                {
                    <a href="/queue" class="btn btn-primary btn-full">
                        @(Matchmaking.IsInQueue ? "IN QUEUE" : "FIND A MATCH")
                        @if (Matchmaking.IsInQueue && Matchmaking.QueueStartedUtc is not null)
                        {
                            <span class="nav-queue-timer">@QueueMatchmakingService.FormatWaitClock(Matchmaking.GetQueueElapsed())</span>
                        }
                    </a>
                }
                <a href="/match-history" class="btn btn-outline btn-full mt-sm">MATCH HISTORY</a>
                <a href="/settings" class="btn btn-outline btn-full mt-sm">ACCOUNT SETTINGS</a>                
                @if (Auth.CurrentUser!.IsAdmin)
                {
                    <a href="/admin" class="btn btn-outline btn-full">ADMIN PANEL</a>
                }
                @if (Auth.CurrentUser!.IsAdmin)
                {
                    <a href="/users" class="btn btn-outline btn-full">VIEW ALL PERSONNEL</a>
                }
                <button class="btn btn-danger btn-full" @onclick="Logout">LOGOUT</button>
            </div>
        </div>
    </div>
}

@using Microsoft.JSInterop

@code {
    bool _pageDataLoaded;
    string? _cachedUsernameFromStorage;
    PlayerSeasonStatsResponseDto? _seasonStats;
    bool _seasonStatsLoaded;
    string? _seasonStatsError;
    UserBanStatusResponseDto? _banStatus;

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChanged;
        Matchmaking.OnStateChanged += OnMatchmakingChanged;
        Resumable.OnChange += OnResumableChanged;
        if (Auth.IsInitialized && !Auth.IsLoggedIn)
            Nav.NavigateTo("/login");
    }

    void OnMatchmakingChanged() => _ = InvokeAsync(StateHasChanged);

    void OnResumableChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _pageDataLoaded)
            return;

        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _pageDataLoaded = true;
        await Resumable.RefreshAsync();

        if (Auth.CurrentUser is { IsActive: true, IsBanned: true })
            _banStatus = await Api.GetMyBanStatusAsync();

        var stats = await Api.GetMyCurrentSeasonStatsAsync();
        _seasonStatsLoaded = true;
        if (stats is null)
        {
            _seasonStats = null;
            _seasonStatsError = "Could not load season stats. Is the API running?";
        }
        else
        {
            _seasonStats = stats;
            _seasonStatsError = null;
        }

        if (Auth.CurrentUser is { } u)
        {
            try
            {
                _cachedUsernameFromStorage = await JS.InvokeAsync<string?>("battleGridProfile.getUserName", u.UserID);
            }
            catch
            {
                _cachedUsernameFromStorage = null;
            }
        }

        StateHasChanged();
    }

    private async void OnAuthChanged()
    {
        await InvokeAsync(() =>
        {
            if (Auth.IsInitialized && !Auth.IsLoggedIn)
            {
                Nav.NavigateTo("/login");
                return Task.CompletedTask;
            }

            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    async Task LeaveQueueFromDashboardAsync()
    {
        await Matchmaking.LeaveQueueAsync();
        StateHasChanged();
    }

    async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }

    string ResolveShownUsername()
    {
        if (Auth.CurrentUser is null)
            return "-";
        if (!string.IsNullOrWhiteSpace(Auth.CurrentUser.UserName))
            return Auth.CurrentUser.UserName;
        if (!string.IsNullOrWhiteSpace(_cachedUsernameFromStorage))
            return _cachedUsernameFromStorage!;
        return "-";
    }

    public ValueTask DisposeAsync()
    {
        Auth.OnChange -= OnAuthChanged;
        Matchmaking.OnStateChanged -= OnMatchmakingChanged;
        Resumable.OnChange -= OnResumableChanged;
        return ValueTask.CompletedTask;
    }
}