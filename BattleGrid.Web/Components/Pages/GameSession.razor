@page "/game/{MatchId:int}"
@implements IAsyncDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject IConfiguration Config
@inject ApiService Api
@inject IJSRuntime JS
@inject ActiveMatchSession MatchSession
@inject ResumableMatchService Resumable
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Text.Json
@using BattleGrid.Contracts.ResponseDtos
@using BattleGrid.Contracts.RequestDtos

<PageTitle>Match @MatchId - BattleGrid</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="loading-screen"><p class="muted">Restoring session...</p></div>
}
else if (!Auth.IsLoggedIn || string.IsNullOrEmpty(Auth.AccessToken))
{
    <div class="loading-screen"><p class="muted">Redirecting to login...</p></div>
}
else
{
    <div class="game-match-view">
    <div class="page-header page-header--match">
        <div class="page-header-top">
            <h1><span class="accent">◈</span> MATCH <span class="accent">#@MatchId</span></h1>
            @if (!_postMatchPhase)
            {
                <button type="button"
                        class="btn btn-sm btn-danger game-match-abandon-btn"
                        disabled="@(_hub?.State != HubConnectionState.Connected)"
                        title="Forfeit and leave this match"
                        @onclick="ConfirmLeaveMatchAsync">
                    Abandon Ship!
                </button>
            }
        </div>
        <p class="muted">@PhaseSubtitle</p>
    </div>

    @if (!_postMatchPhase && !_inBattle)
    {
        <div class="placement-meta muted">
            @if (_placementDeadlineUtc is { } d)
            {
                <span>Time remaining: <strong>@Math.Max(0, (int)Math.Ceiling((d - DateTimeOffset.UtcNow).TotalSeconds))</strong>s</span>
            }
            <button type="button" class="btn btn-sm btn-primary" style="margin-left:12px" disabled="@(_hub?.State != HubConnectionState.Connected)" @onclick="SavePlacementsAsync">Save placements</button>
        </div>

        <div class="game-session-layout">
            <div class="card game-board-card">
                <div class="card-header">
                    <span class="card-icon">▣</span>
                    <span class="card-label">YOUR GRID</span>
                </div>
                <div class="card-body">
                    <div class="placement-toolbar">
                        <span class="muted">Selected: <strong>@(SelectedShip?.ShipName ?? "-")</strong></span>
                        <span class="muted">Orientation: <strong>@(PlacementVertical ? "Vertical" : "Horizontal")</strong></span>
                        <button type="button" class="btn btn-sm btn-outline" @onclick="ToggleRotation">Rotate</button>
                        <span class="muted">Pick ship · Right-click to rotate · Place</span>
                    </div>
                    @if (!string.IsNullOrEmpty(PlacementFeedback))
                    {
                        <p class="muted mt-sm">@PlacementFeedback</p>
                    }
                    <div class="battle-grid-frame battle-grid-frame--fit"
                         tabindex="0"
                         @onkeydown="OnGridKeyDown"
                         @onpointerleave="OnPointerLeaveGrid"
                         @oncontextmenu="OnGridContextMenu"
                         @oncontextmenu:preventDefault="true">
                        <div class="battle-grid">
                            @for (int visualRow = 0; visualRow < Board.GridSize; visualRow++)
                            {
                                var cy = GridCoordinates.YFromVisualRowFromTop(visualRow);
                                <div class="battle-row battle-row-cols">
                                    <div class="battle-axis">@GridCoordinates.DisplayRowNumberFromY(cy)</div>
                                    @for (int x = 0; x < Board.GridSize; x++)
                                    {
                                        var cx = x;
                                        var label = $"{GridCoordinates.ColumnIndexToLetter(cx)}{GridCoordinates.DisplayRowNumberFromY(cy)}";
                                        var pCell = BuildPlacementCell(cx, cy);
                                        <BattleBoardCell CellClass="@pCell.CellClass"
                                                         Title="@($"{label} (internal x={cx}, y={cy})")"
                                                         HullUrl="@pCell.HullUrl"
                                                         HullSliceIndex="@pCell.HullSliceIndex"
                                                         ShipLength="@pCell.ShipLength"
                                                         ShipVertical="@pCell.ShipVertical"
                                                         HullStateClass="@pCell.HullStateClass"
                                                         EffectArtUrl="@pCell.EffectArtUrl"
                                                         OnPointerEnter="@(() => OnPointerEnterCell(cx, cy))"
                                                         OnClick="@(() => OnCellClick(cx, cy))" />
                                    }
                                </div>
                            }
                            <div class="battle-row battle-row-footer battle-row-cols">
                                <div class="battle-corner"></div>
                                @for (int x = 0; x < Board.GridSize; x++)
                                {
                                    <div class="battle-axis battle-axis--col">@GridCoordinates.ColumnIndexToLetter(x)</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card game-dock-card">
                <div class="card-header">
                    <span class="card-icon">⚓</span>
                    <span class="card-label">SHIPS TO PLACE</span>
                </div>
                <div class="card-body">
                    @if (fleetLoading)
                    {
                        <p class="muted">Loading fleet manifest…</p>
                    }
                    else if (fleetError != null)
                    {
                        <div class="alert alert-danger"><span>✘</span> @fleetError</div>
                    }
                    else if (fleetManifest is null || fleetManifest.Count == 0)
                    {
                        <div class="alert alert-info">No ship types configured in the database.</div>
                    }
                    else
                    {
                        <div class="game-dock-summary">
                            <strong>@TotalShipInstances</strong> ship(s) ·
                            <strong>@TotalOccupiedCells</strong> cell(s) ·
                            <strong>@PlacedShipCount</strong> / @TotalShipInstances placed
                        </div>
                        <div class="game-dock-list">
                            <div class="game-dock-list-col">
                                @foreach (var ship in fleetManifest.Take(3))
                                {
                                    <ShipDockCard Ship="ship"
                                                  Selected="SelectedShip?.ShipID == ship.ShipID"
                                                  Exhausted="Remaining(ship) <= 0"
                                                  RemainingCount="Remaining(ship)"
                                                  OnSelect="OnSelectShip" />
                                }
                            </div>
                            <div class="game-dock-list-col">
                                @foreach (var ship in fleetManifest.Skip(3))
                                {
                                    <ShipDockCard Ship="ship"
                                                  Selected="SelectedShip?.ShipID == ship.ShipID"
                                                  Exhausted="Remaining(ship) <= 0"
                                                  RemainingCount="Remaining(ship)"
                                                  OnSelect="OnSelectShip" />
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (_inBattle)
    {
        <div class="battle-hud muted">
            Turn: <strong class="@(_currentTurnPlayerId == Auth.CurrentUser?.UserID ? "turn-indicator turn-indicator--your-salvo" : "turn-indicator turn-indicator--opponent")">@(_currentTurnPlayerId == Auth.CurrentUser?.UserID ? "YOUR SALVO" : "OPPONENT")</strong>
            @if (_shotClockDeadlineUtc is { } sc)
            {
                <span class="muted"> · Shot clock: <strong>@Math.Max(0, (int)Math.Ceiling((sc - DateTimeOffset.UtcNow).TotalSeconds))</strong>s</span>
            }
            @if (!string.IsNullOrEmpty(ShotFeedback))
            {
                <span class="mt-sm"> · @ShotFeedback</span>
            }
        </div>

        <div class="game-battle-boards">
            <div class="card game-board-card">
                <div class="card-header">
                    <span class="card-icon">▣</span>
                    <span class="card-label">YOUR FLEET</span>
                </div>
                <div class="card-body">
                    <div class="game-board-title">Your Fleet's Status</div>
                    <div class="battle-grid-frame battle-grid-frame--fit @(_postMatchPhase ? "battle-grid-frame--frozen" : null)" tabindex="0">
                        <div class="battle-grid">
                            @for (int visualRow = 0; visualRow < Board.GridSize; visualRow++)
                            {
                                var cy = GridCoordinates.YFromVisualRowFromTop(visualRow);
                                <div class="battle-row battle-row-cols">
                                    <div class="battle-axis">@GridCoordinates.DisplayRowNumberFromY(cy)</div>
                                    @for (int x = 0; x < Board.GridSize; x++)
                                    {
                                        var cx = x;
                                        var ownCell = BuildOwnBattleCell(cx, cy);
                                        <BattleBoardCell CellClass="@ownCell.CellClass"
                                                         Title="@($"Own {GridCoordinates.ColumnIndexToLetter(cx)}{GridCoordinates.DisplayRowNumberFromY(cy)}")"
                                                         HullUrl="@ownCell.HullUrl"
                                                         HullSliceIndex="@ownCell.HullSliceIndex"
                                                         ShipLength="@ownCell.ShipLength"
                                                         ShipVertical="@ownCell.ShipVertical"
                                                         HullStateClass="@ownCell.HullStateClass"
                                                         EffectArtUrl="@ownCell.EffectArtUrl"
                                                         OnClick="@(() => OnOwnBattleCellClick(cx, cy))" />
                                    }
                                </div>
                            }
                            <div class="battle-row battle-row-footer battle-row-cols">
                                <div class="battle-corner"></div>
                                @for (int x = 0; x < Board.GridSize; x++)
                                {
                                    <div class="battle-axis battle-axis--col">@GridCoordinates.ColumnIndexToLetter(x)</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card game-board-card game-board-card--opponent">
                <div class="card-header">
                    <span class="card-icon">◎</span>
                    <span class="card-label">TARGET GRID (OPPONENT)</span>
                </div>
                <div class="card-body">
                    <div class="game-board-title">Possible Enemy Ship Locations</div>
                    <div class="battle-grid-frame battle-grid-frame--fit @(_postMatchPhase ? "battle-grid-frame--frozen" : null)" tabindex="0">
                        <div class="battle-grid">
                            @for (int visualRow = 0; visualRow < Board.GridSize; visualRow++)
                            {
                                var cy = GridCoordinates.YFromVisualRowFromTop(visualRow);
                                <div class="battle-row battle-row-cols">
                                    <div class="battle-axis">@GridCoordinates.DisplayRowNumberFromY(cy)</div>
                                    @for (int x = 0; x < Board.GridSize; x++)
                                    {
                                        var cx = x;
                                        var enemyCell = BuildEnemyBattleCell(cx, cy);
                                        <BattleBoardCell CellClass="@enemyCell.CellClass"
                                                         Title="@($"Enemy {GridCoordinates.ColumnIndexToLetter(cx)}{GridCoordinates.DisplayRowNumberFromY(cy)}")"
                                                         EffectArtUrl="@enemyCell.EffectArtUrl"
                                                         OnClick="@(() => OnEnemyBattleCellClick(cx, cy))" />
                                    }
                                </div>
                            }
                            <div class="battle-row battle-row-footer battle-row-cols">
                                <div class="battle-corner"></div>
                                @for (int x = 0; x < Board.GridSize; x++)
                                {
                                    <div class="battle-axis battle-axis--col">@GridCoordinates.ColumnIndexToLetter(x)</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_postMatchPhase && _postMatchDeadlineUtc is { } pmd)
    {
        <div class="card post-match-card">
            <div class="card-header">
                <span class="card-icon">⚑</span>
                <span class="card-label">MATCH RESULT</span>
            </div>
            <div class="card-body">
                @if (Auth.CurrentUser is { } me)
                {
                    @if (_matchWinnerUserId is { } winnerId)
                    {
                        var won = winnerId == me.UserID;
                        <p class="post-match-headline @(won ? "post-match-headline--victory" : "post-match-headline--defeat")">@(won ? "Victory" : "Defeat")</p>
                        <p class="muted">Winner: @GetWinnerDisplayLabel()</p>
                        <p class="muted">Your rating change: <strong>@FormatSignedDelta(me.UserID == _player1Id ? _p1RatingDelta : _p2RatingDelta)</strong></p>
                    }
                    else
                    {
                        <p class="post-match-headline">Match ended</p>
                        <p class="muted">No winner was recorded for this match.</p>
                        <p class="muted">Your rating change: <strong>@FormatSignedDelta(me.UserID == _player1Id ? _p1RatingDelta : _p2RatingDelta)</strong></p>
                    }
                    <p class="muted">Return to dashboard in <strong>@Math.Max(0, (int)Math.Ceiling((pmd - DateTimeOffset.UtcNow).TotalSeconds))</strong>s or use the button.</p>
                }
                <button type="button" class="btn btn-primary btn-full mt-sm" @onclick="GoDashboardAsync">Go to dashboard</button>
            </div>
        </div>
    }

    <footer class="game-session-status-bar muted" aria-live="polite">
        <span>Live channel: <strong>@status</strong></span>
        <span class="game-session-status-sep" aria-hidden="true">·</span>
        <span>Last event: <strong>@lastEvent</strong></span>
    </footer>
    </div>
}

@code {
    static readonly JsonSerializerOptions HubJson = new() { PropertyNameCaseInsensitive = true };

    [Parameter] public int MatchId { get; set; }

    string status = "Connecting…";
    string lastEvent = "-";
    HubConnection? _hub;
    bool _started;

    bool _inBattle;
    int _player1Id;
    int _player2Id;
    int _currentTurnPlayerId;
    DateTimeOffset? _placementDeadlineUtc;
    CancellationTokenSource? _placementUiCts;
    CancellationTokenSource? _draftSyncCts;

    bool _postMatchPhase;
    int? _matchWinnerUserId;
    string? _player1DisplayName;
    string? _player2DisplayName;
    int _p1RatingDelta;
    int _p2RatingDelta;
    DateTimeOffset? _postMatchDeadlineUtc;
    CancellationTokenSource? _postMatchUiCts;

    DateTimeOffset? _shotClockDeadlineUtc;
    CancellationTokenSource? _shotUiCts;

    List<ShipTypeListResponseDto>? fleetManifest;
    bool fleetLoading = true;
    string? fleetError;

    ShipTypeListResponseDto? SelectedShip;
    bool PlacementVertical;
    (int x, int y)? HoverCell;
    readonly Dictionary<int, int> _placedCount = new();
    readonly Dictionary<(int x, int y), int> _occupyingShipId = new();
    readonly Dictionary<(int x, int y), int> _cellToPlacementIndex = new();
    readonly List<PlacedShipDto> _placementOrder = new();
    string? PlacementFeedback;
    string? ShotFeedback;

    readonly Dictionary<(int x, int y), string> _enemyIntel = new();
    readonly Dictionary<(int x, int y), string> _incomingOnOwn = new();
    readonly Dictionary<(int x, int y), ShotCellFxPhase> _targetGridFxPhase = new();
    readonly Dictionary<(int x, int y), ShotCellFxPhase> _ownFleetFxPhase = new();
    readonly Dictionary<(int x, int y), DateTimeOffset> _targetGridMissAnimMinUntil = new();
    readonly Dictionary<(int x, int y), DateTimeOffset> _ownFleetMissAnimMinUntil = new();

    const int MissEffectAnimMs = 500;
    bool _battleFxPreloaded;

    string PhaseSubtitle => _postMatchPhase
        ? "Match ended"
        : _inBattle
            ? "Battle Phase"
            : "Ship Placement Phase";

    int TotalShipInstances => fleetManifest?.Sum(s => s.MaxPerPlayer) ?? 0;

    int TotalOccupiedCells => fleetManifest?.Sum(s => s.Length * s.Width * s.MaxPerPlayer) ?? 0;

    int PlacedShipCount => _placedCount.Values.Sum();

    static string FormatSignedDelta(int d) => d > 0 ? $"+{d}" : d.ToString();

    string GetWinnerDisplayLabel()
    {
        if (_matchWinnerUserId is not { } w)
            return "-";
        if (w == _player1Id && !string.IsNullOrWhiteSpace(_player1DisplayName))
            return _player1DisplayName!;
        if (w == _player2Id && !string.IsNullOrWhiteSpace(_player2DisplayName))
            return _player2DisplayName!;
        return $"user #{w}";
    }

    int Remaining(ShipTypeListResponseDto ship) =>
        ship.MaxPerPlayer - _placedCount.GetValueOrDefault(ship.ShipID);

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChanged;
        if (Auth.IsInitialized && (!Auth.IsLoggedIn || string.IsNullOrEmpty(Auth.AccessToken)))
            Nav.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        var raw = await Api.GetShipTypesAsync();
        if (raw is null)
            fleetError = "Failed to load fleet data. Is the API running?";
        else
            fleetManifest = raw.OrderBy(s => s.ShipID).ToList();
        fleetLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn || string.IsNullOrEmpty(Auth.AccessToken))
        {
            Nav.NavigateTo("/login");
            return;
        }

        _started = true;
        await TryApplyMatchRecoveryFromApiAsync();
        await StartHubAsync();
        await PreloadBattleFxAsync();
        StateHasChanged();
    }

    void OnSelectShip(ShipTypeListResponseDto ship)
    {
        if (_inBattle || Remaining(ship) <= 0)
            return;

        if (SelectedShip?.ShipID == ship.ShipID)
        {
            SelectedShip = null;
            HoverCell = null;
        }
        else
            SelectedShip = ship;

        PlacementFeedback = null;
        StateHasChanged();
    }

    void ToggleRotation()
    {
        PlacementVertical = !PlacementVertical;
        PlacementFeedback = null;
        StateHasChanged();
    }

    void OnGridKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "r" or "R")
            ToggleRotation();
    }

    void OnGridContextMenu()
    {
        ToggleRotation();
    }

    void OnPointerEnterCell(int x, int y)
    {
        if (_inBattle || SelectedShip is null)
            return;

        HoverCell = (x, y);
        StateHasChanged();
    }

    void OnPointerLeaveGrid()
    {
        HoverCell = null;
        StateHasChanged();
    }

    void OnCellClick(int x, int y)
    {
        if (_inBattle)
            return;
        TryPlace(x, y);
    }

    bool TryGetPreviewCells([System.Diagnostics.CodeAnalysis.NotNullWhen(true)] out List<Coordinate>? cells)
    {
        cells = null;
        if (SelectedShip is null || HoverCell is null)
            return false;

        return ShipPlacementHelper.TryGenerateRectangle(
            new Coordinate(HoverCell.Value.x, HoverCell.Value.y),
            SelectedShip.Length,
            SelectedShip.Width,
            PlacementVertical,
            out cells);
    }

    bool PreviewOverlaps(List<Coordinate> cells) =>
        cells.Exists(c => _occupyingShipId.ContainsKey((c.X, c.Y)));

    sealed record BattleCellVisual(
        string CellClass,
        string? HullUrl,
        int HullSliceIndex,
        int ShipLength,
        bool ShipVertical,
        string? HullStateClass,
        string? EffectArtUrl);

    void RebuildPlacementCellMap()
    {
        _cellToPlacementIndex.Clear();
        if (fleetManifest is null)
            return;

        for (var i = 0; i < _placementOrder.Count; i++)
        {
            var placement = _placementOrder[i];
            var ship = fleetManifest.FirstOrDefault(s => s.ShipID == placement.ShipID);
            if (ship is null)
                continue;

            if (!ShipPlacementHelper.TryGenerateRectangle(
                    new Coordinate(placement.StartX, placement.StartY),
                    ship.Length,
                    ship.Width,
                    placement.IsVertical,
                    out var cells) || cells is null)
                continue;

            foreach (var c in cells)
                _cellToPlacementIndex[(c.X, c.Y)] = i;
        }
    }

    ShipTypeListResponseDto? GetShipForPlacement(int placementIndex)
    {
        if (placementIndex < 0 || placementIndex >= _placementOrder.Count)
            return null;

        var shipId = _placementOrder[placementIndex].ShipID;
        return fleetManifest?.FirstOrDefault(s => s.ShipID == shipId);
    }

    IEnumerable<(int X, int Y)> GetCellsForPlacement(int placementIndex)
    {
        if (placementIndex < 0 || placementIndex >= _placementOrder.Count)
            yield break;

        var placement = _placementOrder[placementIndex];
        var ship = GetShipForPlacement(placementIndex);
        if (ship is null)
            yield break;

        if (!ShipPlacementHelper.TryGenerateRectangle(
                new Coordinate(placement.StartX, placement.StartY),
                ship.Length,
                ship.Width,
                placement.IsVertical,
                out var cells) || cells is null)
            yield break;

        foreach (var c in cells)
            yield return (c.X, c.Y);
    }

    bool IsPlacementSunk(int placementIndex)
    {
        foreach (var (x, y) in GetCellsForPlacement(placementIndex))
        {
            if (_incomingOnOwn.TryGetValue((x, y), out var result) &&
                result is "Sunk" or "Win")
                return true;
        }

        return false;
    }

    ShipSegmentState GetSegmentState(int placementIndex, int x, int y)
    {
        if (IsPlacementSunk(placementIndex))
            return ShipSegmentState.Destroyed;

        if (_incomingOnOwn.TryGetValue((x, y), out var incoming))
        {
            if (incoming is "Sunk" or "Win")
                return ShipSegmentState.Destroyed;
            if (incoming is "Hit")
                return ShipSegmentState.Damaged;
        }

        return ShipSegmentState.Intact;
    }

    bool TryGetShipHull(
        int placementIndex,
        int x,
        int y,
        out string? hullUrl,
        out int sliceIndex,
        out int shipLength,
        out bool vertical,
        out string hullStateClass)
    {
        hullUrl = null;
        sliceIndex = 0;
        shipLength = 1;
        vertical = false;
        hullStateClass = "";

        var placement = _placementOrder[placementIndex];
        var ship = GetShipForPlacement(placementIndex);
        if (ship is null)
            return false;

        var slug = ShipVisualHelper.SlugFromShipName(ship.ShipName);
        hullUrl = ShipVisualHelper.GetHullAssetUrl(slug);
        shipLength = ship.Length;
        sliceIndex = ShipVisualHelper.GetSliceIndexFromBow(placement, x, y, ship.Length);
        vertical = placement.IsVertical;
        hullStateClass = ShipVisualHelper.HullLayerModifierClass(GetSegmentState(placementIndex, x, y));
        return true;
    }

    static BattleCellVisual EmptyCell(string cellClass, string? effectUrl = null) =>
        new(cellClass, null, 0, 1, false, null, effectUrl);

    string? ResolveShotEffectUrl(
        string result,
        int x,
        int y,
        Dictionary<(int x, int y), ShotCellFxPhase> fxPhase,
        Dictionary<(int x, int y), DateTimeOffset> missAnimMinUntil)
    {
        var key = (x, y);

        if (string.Equals(result, "Miss", StringComparison.OrdinalIgnoreCase))
        {
            if (missAnimMinUntil.TryGetValue(key, out var until) && DateTimeOffset.UtcNow < until)
                return ShipVisualHelper.GetShotFxUrl(ShotCellFxPhase.MissAnimation);

            if (fxPhase.TryGetValue(key, out var missPhase) && missPhase == ShotCellFxPhase.MissAnimation)
                return ShipVisualHelper.GetShotFxUrl(ShotCellFxPhase.MissAnimation);

            return ShipVisualHelper.GetShotFxUrl(ShotCellFxPhase.MissSettled);
        }

        if (string.Equals(result, "Hit", StringComparison.OrdinalIgnoreCase))
        {
            if (fxPhase.TryGetValue(key, out var hitPhase) && hitPhase == ShotCellFxPhase.HitSettled)
                return ShipVisualHelper.GetShotFxUrl(ShotCellFxPhase.HitSettled);

            return ShipVisualHelper.GetShotFxUrl(ShotCellFxPhase.HitAnimation);
        }

        if (result is "Sunk" or "Win")
            return ShipVisualHelper.GetShotFxUrl(ShotCellFxPhase.HitSettled);

        return null;
    }

    void OnShotVisualEffect(ShotFiredMessage msg, bool onTargetGrid)
    {
        var fxPhase = onTargetGrid ? _targetGridFxPhase : _ownFleetFxPhase;
        var missAnimMinUntil = onTargetGrid ? _targetGridMissAnimMinUntil : _ownFleetMissAnimMinUntil;
        var key = (msg.X, msg.Y);

        if (string.Equals(msg.Result, "Miss", StringComparison.OrdinalIgnoreCase))
        {
            fxPhase[key] = ShotCellFxPhase.MissAnimation;
            missAnimMinUntil[key] = DateTimeOffset.UtcNow.AddMilliseconds(MissEffectAnimMs);
            return;
        }

        if (string.Equals(msg.Result, "Hit", StringComparison.OrdinalIgnoreCase))
        {
            fxPhase[key] = ShotCellFxPhase.HitAnimation;
            return;
        }

        if (string.Equals(msg.Result, "Sunk", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(msg.Result, "Win", StringComparison.OrdinalIgnoreCase))
        {
            if (msg.SunkCells is { Count: > 0 })
            {
                foreach (var c in msg.SunkCells)
                    fxPhase[(c.X, c.Y)] = ShotCellFxPhase.HitSettled;
            }
            else
                fxPhase[key] = ShotCellFxPhase.HitSettled;
        }
    }

    async Task ProcessShotFiredUiAsync(ShotFiredMessage msg, bool onTargetGrid)
    {
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        if (string.Equals(msg.Result, "Miss", StringComparison.OrdinalIgnoreCase))
        {
            var fxPhase = onTargetGrid ? _targetGridFxPhase : _ownFleetFxPhase;
            var missAnimMinUntil = onTargetGrid ? _targetGridMissAnimMinUntil : _ownFleetMissAnimMinUntil;
            var key = (msg.X, msg.Y);
            if (missAnimMinUntil.TryGetValue(key, out var until))
            {
                var remaining = until - DateTimeOffset.UtcNow;
                if (remaining > TimeSpan.Zero)
                    await Task.Delay(remaining);
            }

            fxPhase[key] = ShotCellFxPhase.MissSettled;
            missAnimMinUntil.Remove(key);
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            await TryPlayShotResultSoundAsync(msg.Result);
        }
        catch
        {
            // audio optional
        }
    }

    async Task PreloadBattleFxAsync()
    {
        if (_battleFxPreloaded)
            return;

        _battleFxPreloaded = true;
        try
        {
            await JS.InvokeVoidAsync("battleGridFx.preload", ShipVisualHelper.GetPreloadEffectUrls());
        }
        catch
        {
            _battleFxPreloaded = false;
        }
    }

    void ApplySettledFxForIntelCell(int x, int y, string result, bool onTargetGrid)
    {
        var fxPhase = onTargetGrid ? _targetGridFxPhase : _ownFleetFxPhase;
        if (string.Equals(result, "Miss", StringComparison.OrdinalIgnoreCase))
            fxPhase[(x, y)] = ShotCellFxPhase.MissSettled;
        else if (string.Equals(result, "Hit", StringComparison.OrdinalIgnoreCase))
            fxPhase[(x, y)] = ShotCellFxPhase.HitAnimation;
        else if (result is "Sunk" or "Win")
            fxPhase[(x, y)] = ShotCellFxPhase.HitSettled;
    }

    BattleCellVisual BuildPlacementCell(int x, int y)
    {
        if (_cellToPlacementIndex.TryGetValue((x, y), out var placementIndex) &&
            TryGetShipHull(placementIndex, x, y, out var hullUrl, out var slice, out var len, out var vertical, out var stateClass))
        {
            return new BattleCellVisual(
                "battle-cell battle-cell-water battle-cell--placed",
                hullUrl, slice, len, vertical, stateClass, null);
        }

        return EmptyCell(GetPlacementCellClass(x, y));
    }

    BattleCellVisual BuildOwnBattleCell(int x, int y)
    {
        string? effectUrl = null;
        var cellClass = "battle-cell battle-cell-water";

        if (_incomingOnOwn.TryGetValue((x, y), out var incoming))
        {
            cellClass = incoming switch
            {
                "Miss" => "battle-cell battle-cell-water battle-cell--incoming-miss battle-cell--has-fx",
                "Hit" or "Sunk" or "Win" => "battle-cell battle-cell-water battle-cell--incoming-hit",
                _ => cellClass
            };
            effectUrl = ResolveShotEffectUrl(incoming, x, y, _ownFleetFxPhase, _ownFleetMissAnimMinUntil);
        }

        if (_cellToPlacementIndex.TryGetValue((x, y), out var placementIndex) &&
            TryGetShipHull(placementIndex, x, y, out var hullUrl, out var slice, out var len, out var vertical, out var stateClass))
        {
            return new BattleCellVisual(
                "battle-cell battle-cell-water battle-cell--placed",
                hullUrl, slice, len, vertical, stateClass, effectUrl);
        }

        return EmptyCell(cellClass, effectUrl);
    }

    BattleCellVisual BuildEnemyBattleCell(int x, int y)
    {
        var sel = !_postMatchPhase ? " battle-cell--selectable" : "";
        string? effectUrl = null;
        var cellClass = $"battle-cell battle-cell-fog{sel}";

        if (_enemyIntel.TryGetValue((x, y), out var intel))
        {
            cellClass = intel switch
            {
                "Miss" => $"battle-cell battle-cell-fog battle-cell--intel-miss battle-cell--has-fx{sel}",
                "Hit" => $"battle-cell battle-cell-fog battle-cell--intel-hit battle-cell--has-fx{sel}",
                "Sunk" => $"battle-cell battle-cell-fog battle-cell--intel-sunk battle-cell--has-fx{sel}",
                "Win" => $"battle-cell battle-cell-fog battle-cell--intel-sunk battle-cell--has-fx{sel}",
                _ => cellClass
            };
            effectUrl = ResolveShotEffectUrl(intel, x, y, _targetGridFxPhase, _targetGridMissAnimMinUntil);
        }

        return EmptyCell(cellClass, effectUrl);
    }

    string GetPlacementCellClass(int x, int y)
    {
        if (_occupyingShipId.TryGetValue((x, y), out _))
            return "battle-cell battle-cell-water battle-cell--placed";

        var isAnchor = SelectedShip is not null && HoverCell is { } h && h.x == x && h.y == y;
        var hasPreview = TryGetPreviewCells(out var prev) && prev is not null;

        if (SelectedShip is not null && isAnchor && !hasPreview)
            return "battle-cell battle-cell--preview-bad battle-cell--selectable";

        if (SelectedShip is not null && hasPreview && prev!.Exists(c => c.X == x && c.Y == y))
        {
            var valid = !PreviewOverlaps(prev);
            return valid
                ? "battle-cell battle-cell--preview-ok battle-cell--selectable"
                : "battle-cell battle-cell--preview-bad battle-cell--selectable";
        }

        return SelectedShip is not null
            ? "battle-cell battle-cell-water battle-cell--selectable"
            : "battle-cell battle-cell-water";
    }

    void TryPlace(int x, int y)
    {
        HoverCell = (x, y);
        PlacementFeedback = null;

        if (SelectedShip is null)
        {
            PlacementFeedback = "Choose a ship from the list first.";
            return;
        }

        if (Remaining(SelectedShip) <= 0)
            return;

        if (!ShipPlacementHelper.TryGenerateRectangle(
                new Coordinate(x, y),
                SelectedShip.Length,
                SelectedShip.Width,
                PlacementVertical,
                out var cells) || cells is null)
        {
            PlacementFeedback = "That ship does not fit entirely on the grid from this cell.";
            return;
        }

        if (PreviewOverlaps(cells))
        {
            PlacementFeedback = "Overlaps another ship.";
            return;
        }

        foreach (var c in cells)
            _occupyingShipId[(c.X, c.Y)] = SelectedShip.ShipID;

        _placedCount[SelectedShip.ShipID] = _placedCount.GetValueOrDefault(SelectedShip.ShipID) + 1;
        _placementOrder.Add(new PlacedShipDto
        {
            ShipID = SelectedShip.ShipID,
            StartX = x,
            StartY = y,
            IsVertical = PlacementVertical
        });
        PlacementFeedback = $"{SelectedShip.ShipName} placed.";

        if (Remaining(SelectedShip) <= 0)
            SelectedShip = null;

        HoverCell = (x, y);
        RebuildPlacementCellMap();
        StateHasChanged();
        ScheduleDraftSync();
    }

    void ScheduleDraftSync()
    {
        if (_inBattle || _hub is null || _hub.State != HubConnectionState.Connected)
            return;

        try
        {
            _draftSyncCts?.Cancel();
            _draftSyncCts?.Dispose();
            _draftSyncCts = new CancellationTokenSource();
            var ct = _draftSyncCts.Token;
            var delayMs = PlacedShipCount >= TotalShipInstances ? 0 : 300;
            _ = PushDraftDebouncedAsync(ct, delayMs);
        }
        catch
        {
            // ignore
        }
    }

    async Task PushDraftDebouncedAsync(CancellationToken ct, int delayMs)
    {
        try
        {
            if (delayMs > 0)
                await Task.Delay(delayMs, ct);

            if (ct.IsCancellationRequested || _inBattle || _hub is null || _hub.State != HubConnectionState.Connected)
                return;

            await _hub.InvokeAsync("UpdatePlacementDraft", _placementOrder.ToList());
        }
        catch (OperationCanceledException)
        {
            // debounce superseded
        }
        catch
        {
            // hub / circuit not ready
        }
    }

    async Task SavePlacementsAsync()
    {
        if (_hub is null || _hub.State != HubConnectionState.Connected)
            return;

        try
        {
            _draftSyncCts?.Cancel();
            await _hub.InvokeAsync("UpdatePlacementDraft", _placementOrder.ToList());
            await _hub.InvokeAsync("ReadyWithPlacements", _placementOrder.ToList());
            PlacementFeedback = "Placements submitted - waiting for opponent or timer.";
        }
        catch (Exception ex)
        {
            PlacementFeedback = $"Could not submit: {ex.Message}";
        }

        StateHasChanged();
    }

    void OnOwnBattleCellClick(int x, int y)
    {
        if (_postMatchPhase)
            return;

        ShotFeedback = "You cannot fire at your own fleet. Use the enemy grid.";
        StateHasChanged();
    }

    async Task OnEnemyBattleCellClick(int x, int y)
    {
        if (_postMatchPhase)
            return;

        if (_hub is null || _hub.State != HubConnectionState.Connected)
            return;

        if (Auth.CurrentUser?.UserID != _currentTurnPlayerId)
        {
            ShotFeedback = "Not your turn.";
            StateHasChanged();
            return;
        }

        try
        {
            await _hub.InvokeAsync("FireShot", x, y);
        }
        catch (Exception ex)
        {
            ShotFeedback = ex.Message;
        }

        StateHasChanged();
    }

    /// <summary>
    /// After a Blazor-only restart, the API may have already finished the match and persisted results.
    /// Clients miss the SignalR <c>MatchEnded</c> broadcast, so we hydrate post-match UI from the REST API.
    /// </summary>
    async Task TryApplyMatchRecoveryFromApiAsync()
    {
        var dto = await Api.GetMatchRecoveryIfTerminalAsync(MatchId);
        if (dto is null)
            return;

        _player1Id = dto.Player1Id;
        _player2Id = dto.Player2Id;
        _player1DisplayName = dto.Player1UserName;
        _player2DisplayName = dto.Player2UserName;
        _matchWinnerUserId = dto.WinnerUserId;
        _p1RatingDelta = dto.Player1RatingChange;
        _p2RatingDelta = dto.Player2RatingChange;
        _inBattle = dto.TotalNoOfMoves > 0;
        _postMatchPhase = true;
        _postMatchDeadlineUtc = DateTimeOffset.UtcNow.AddSeconds(45);
        _placementDeadlineUtc = null;
        _placementUiCts?.Cancel();
        _draftSyncCts?.Cancel();
        _draftSyncCts?.Dispose();
        _draftSyncCts = null;
        ResetShotUiTicker();
        lastEvent = "Match ended (recovered from server)";
        StartPostMatchCountdown();
        await TryPlayMatchEndedSoundAsync(dto.WinnerUserId);
    }

    async Task TryPlayMatchEndedSoundAsync(int? winnerUserId)
    {
        try
        {
            if (Auth.CurrentUser is not { UserID: var me })
                return;
            if (winnerUserId is null)
                return;
            var fn = winnerUserId.Value == me ? "battleGridSounds.playMatchVictory" : "battleGridSounds.playMatchDefeat";
            await JS.InvokeVoidAsync(fn);
        }
        catch
        {
            // ignore missing audio context (SSR / autoplay policy)
        }
    }

    static bool IsShotHitResult(string result) =>
        result.Equals("Hit", StringComparison.OrdinalIgnoreCase)
        || result.Equals("Sunk", StringComparison.OrdinalIgnoreCase)
        || result.Equals("Win", StringComparison.OrdinalIgnoreCase);

    async Task TryPlayShotResultSoundAsync(string result)
    {
        try
        {
            if (IsShotHitResult(result))
                await JS.InvokeVoidAsync("battleGridSounds.playShotHit");
            else if (result.Equals("Miss", StringComparison.OrdinalIgnoreCase))
                await JS.InvokeVoidAsync("battleGridSounds.playShotMiss");
        }
        catch
        {
            // ignore missing audio context (SSR / autoplay policy)
        }
    }

    async Task StartHubAsync()
    {
        _hub = ApiHubConnectionFactory.Create(Config, Auth, $"/game/{MatchId}");

        _hub.On<int>("PlayerJoined", uid =>
        {
            lastEvent = $"Player {uid} joined";
            return InvokeAsync(StateHasChanged);
        });

        _hub.On<JsonElement>("PlacementPhaseStarted", e =>
        {
            var msg = JsonSerializer.Deserialize<PlacementPhaseStartedMessage>(e.GetRawText(), HubJson);
            if (msg is not null)
            {
                _placementDeadlineUtc = msg.DeadlineUtc;
                StartPlacementCountdown();
            }

            lastEvent = "Placement phase started (45s)";
            return InvokeAsync(() =>
            {
                ScheduleDraftSync();
                StateHasChanged();
            });
        });

        _hub.On<JsonElement>("BattleStarted", e =>
        {
            var msg = JsonSerializer.Deserialize<BattleStartedMessage>(e.GetRawText(), HubJson);
            if (msg is null)
                return Task.CompletedTask;

            _inBattle = true;
            _player1Id = msg.Player1Id;
            _player2Id = msg.Player2Id;
            _currentTurnPlayerId = msg.CurrentTurnPlayerId;
            _placementDeadlineUtc = null;
            _draftSyncCts?.Cancel();
            _draftSyncCts?.Dispose();
            _draftSyncCts = null;
            _placementUiCts?.Cancel();
            lastEvent = "Battle started";
            PlacementFeedback = null;
            _shotClockDeadlineUtc = DateTimeOffset.UtcNow.AddSeconds(15);
            StartShotClockCountdown();
            return InvokeAsync(StateHasChanged);
        });

        _hub.On<JsonElement>("ShotFired", e =>
        {
            var msg = JsonSerializer.Deserialize<ShotFiredMessage>(e.GetRawText(), HubJson);
            if (msg is null || Auth.CurrentUser is null)
                return Task.CompletedTask;

            var me = Auth.CurrentUser.UserID;
            var onTargetGrid = msg.ShooterId == me;
            if (onTargetGrid)
                _enemyIntel[(msg.X, msg.Y)] = msg.Result;
            else
                _incomingOnOwn[(msg.X, msg.Y)] = msg.Result;

            OnShotVisualEffect(msg, onTargetGrid);

            _currentTurnPlayerId = msg.CurrentTurnPlayerId;
            if (msg.ShotClockDeadlineUtc != default)
            {
                _shotClockDeadlineUtc = msg.ShotClockDeadlineUtc;
                StartShotClockCountdown();
            }

            var suffix = msg.ForcedTimeout ? " (auto - open water)" : "";
            ShotFeedback = $"Salvo {(msg.ShooterId == me ? "away" : "incoming")}: {msg.Result}{suffix}";
            lastEvent = $"Shot {msg.Result}";
            return ProcessShotFiredUiAsync(msg, onTargetGrid);
        });

        _hub.On<string>("ShotRejected", async reason =>
        {
            ShotFeedback = reason;
            if (reason.Contains("already", StringComparison.OrdinalIgnoreCase) ||
                reason.Contains("targeted", StringComparison.OrdinalIgnoreCase))
            {
                try
                {
                    await JS.InvokeVoidAsync("battleGridSounds.playWarning");
                }
                catch
                {
                    // ignore missing audio context (SSR / autoplay policy)
                }
            }

            await InvokeAsync(StateHasChanged);
        });

        _hub.On<JsonElement>("MatchEnded", e =>
        {
            var msg = JsonSerializer.Deserialize<MatchEndedMessage>(e.GetRawText(), HubJson);
            if (msg is null)
                return Task.CompletedTask;

            _player1Id = msg.Player1Id;
            _player2Id = msg.Player2Id;
            _player1DisplayName = msg.Player1UserName;
            _player2DisplayName = msg.Player2UserName;
            _postMatchPhase = true;
            _postMatchDeadlineUtc = msg.PostMatchDeadlineUtc;
            _matchWinnerUserId = msg.WinnerUserId;
            _p1RatingDelta = msg.Player1RatingChange;
            _p2RatingDelta = msg.Player2RatingChange;
            _placementDeadlineUtc = null;
            _placementUiCts?.Cancel();
            _draftSyncCts?.Cancel();
            _draftSyncCts?.Dispose();
            _draftSyncCts = null;
            ResetShotUiTicker();
            StartPostMatchCountdown();
            lastEvent = "Match ended";
            return InvokeAsync(async () =>
            {
                await TryPlayMatchEndedSoundAsync(msg.WinnerUserId);
                StateHasChanged();
            });
        });

        _hub.On<string>("MatchPersistFailed", msg =>
        {
            ShotFeedback = $"Could not save match: {msg}";
            lastEvent = "Match persist failed";
            return InvokeAsync(StateHasChanged);
        });

        _hub.On<string>("PlacementSaveFailed", msg =>
        {
            PlacementFeedback = $"Placement save failed: {msg}";
            lastEvent = "Placement save failed";
            return InvokeAsync(StateHasChanged);
        });

        _hub.On<JsonElement>("FleetPlacementSync", e =>
        {
            var msg = JsonSerializer.Deserialize<FleetPlacementSyncMessage>(e.GetRawText(), HubJson);
            if (msg is not null)
                ApplyFleetPlacementFromServer(msg);
            lastEvent = "Fleet layout synced";
            return InvokeAsync(StateHasChanged);
        });

        _hub.On<JsonElement>("YourBattleSnapshot", e =>
        {
            var msg = JsonSerializer.Deserialize<YourBattleSnapshotMessage>(e.GetRawText(), HubJson);
            if (msg is not null)
                ApplyBattleSnapshotFromServer(msg);
            lastEvent = "Battle snapshot";
            return InvokeAsync(StateHasChanged);
        });

        _hub.On<JsonElement>("MatchAbandoned", async _ =>
        {
            await InvokeAsync(async () =>
            {
                ResetShotUiTicker();
                if (!_postMatchPhase)
                    await TryApplyMatchRecoveryFromApiAsync();
                if (_postMatchPhase)
                    StateHasChanged();
                else
                {
                    await LeaveMatchUiAsync();
                    Nav.NavigateTo("/dashboard");
                }
            });
        });

        _hub.On<JsonElement>("BattleResynced", e =>
        {
            var msg = JsonSerializer.Deserialize<BattleStartedMessage>(e.GetRawText(), HubJson);
            if (msg is null)
                return Task.CompletedTask;
            _inBattle = true;
            _player1Id = msg.Player1Id;
            _player2Id = msg.Player2Id;
            _currentTurnPlayerId = msg.CurrentTurnPlayerId;
            _draftSyncCts?.Cancel();
            _draftSyncCts?.Dispose();
            _draftSyncCts = null;
            if (!_shotClockDeadlineUtc.HasValue || _shotClockDeadlineUtc.GetValueOrDefault() == default)
                _shotClockDeadlineUtc = DateTimeOffset.UtcNow.AddSeconds(15);
            StartShotClockCountdown();
            return InvokeAsync(StateHasChanged);
        });

        _hub.Closed += async ex =>
        {
            status = ex is null ? "Disconnected from game hub." : $"Disconnected: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        };

        try
        {
            await _hub.StartAsync();
            status = "Connected to game hub.";
            MatchSession.EnterMatch(MatchId);
            try
            {
                await JS.InvokeVoidAsync("battleGridMatchGuard.setActive", true);
            }
            catch
            {
                // ignore
            }

            ScheduleDraftSync();
        }
        catch (Exception ex)
        {
            status = $"Could not connect: {ex.Message}";
        }
    }

    void StartPlacementCountdown()
    {
        _placementUiCts?.Cancel();
        _placementUiCts?.Dispose();
        _placementUiCts = new CancellationTokenSource();
        var ct = _placementUiCts.Token;
        _ = RunPlacementUiTicker(ct);
    }

    async Task RunPlacementUiTicker(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested && !_inBattle && _placementDeadlineUtc is { } d && DateTimeOffset.UtcNow < d)
            {
                await Task.Delay(500, ct);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // ignore
        }
    }

    void ApplyOwnFleetCellsFromSnapshot(IReadOnlyList<FleetLayoutCellDto>? cells)
    {
        if (cells is null || cells.Count == 0)
            return;

        if (fleetManifest is not null)
        {
            var manifestIds = fleetManifest.Select(s => s.ShipID).ToHashSet();
            foreach (var key in _occupyingShipId.Keys.ToList())
            {
                if (_occupyingShipId.TryGetValue(key, out var sid) && manifestIds.Contains(sid))
                    _occupyingShipId.Remove(key);
            }
        }
        else
            _occupyingShipId.Clear();

        foreach (var c in cells)
            _occupyingShipId[(c.X, c.Y)] = c.ShipTypeId;

        _placedCount.Clear();
        foreach (var c in cells)
            _placedCount[c.ShipTypeId] = _placedCount.GetValueOrDefault(c.ShipTypeId) + 1;
    }

    void TryReconstructPlacementsFromOwnFleet(IReadOnlyList<FleetLayoutCellDto> cells)
    {
        var byShip = cells.GroupBy(c => c.ShipTypeId);
        var reconstructed = new List<PlacedShipDto>();
        var visited = new HashSet<(int X, int Y)>();

        foreach (var group in byShip)
        {
            foreach (var start in group)
            {
                var key = (start.X, start.Y);
                if (!visited.Add(key))
                    continue;

                var component = new List<FleetLayoutCellDto>();
                var queue = new Queue<FleetLayoutCellDto>();
                queue.Enqueue(start);

                while (queue.Count > 0)
                {
                    var cell = queue.Dequeue();
                    component.Add(cell);

                    foreach (var (nx, ny) in new[] { (cell.X - 1, cell.Y), (cell.X + 1, cell.Y), (cell.X, cell.Y - 1), (cell.X, cell.Y + 1) })
                    {
                        var neighbor = group.FirstOrDefault(c => c.X == nx && c.Y == ny);
                        if (neighbor is null)
                            continue;

                        var nKey = (neighbor.X, neighbor.Y);
                        if (!visited.Add(nKey))
                            continue;

                        queue.Enqueue(neighbor);
                    }
                }

                if (component.Count == 0)
                    continue;

                var xs = component.Select(c => c.X).Distinct().ToList();
                var ys = component.Select(c => c.Y).Distinct().ToList();
                var vertical = xs.Count == 1;
                if (!vertical && ys.Count != 1)
                    continue;

                reconstructed.Add(new PlacedShipDto
                {
                    ShipID = group.Key,
                    StartX = vertical ? xs[0] : xs.Min(),
                    StartY = vertical ? ys.Min() : ys[0],
                    IsVertical = vertical
                });
            }
        }

        if (reconstructed.Count > 0)
        {
            _placementOrder.Clear();
            _placementOrder.AddRange(reconstructed);
        }
    }

    void ApplyFleetPlacementFromServer(FleetPlacementSyncMessage msg)
    {
        if (msg.Cells is null || msg.Cells.Count == 0)
            return;

        ApplyOwnFleetCellsFromSnapshot(msg.Cells);

        if (msg.Placements is { Count: > 0 })
        {
            _placementOrder.Clear();
            _placementOrder.AddRange(msg.Placements);
        }

        SelectedShip = null;
        HoverCell = null;
        RebuildPlacementCellMap();
    }

    void ApplyBattleSnapshotFromServer(YourBattleSnapshotMessage msg)
    {
        _player1Id = msg.Player1Id;
        _player2Id = msg.Player2Id;
        _currentTurnPlayerId = msg.CurrentTurnPlayerId;
        _inBattle = true;
        _enemyIntel.Clear();
        _incomingOnOwn.Clear();
        _targetGridFxPhase.Clear();
        _ownFleetFxPhase.Clear();
        _targetGridMissAnimMinUntil.Clear();
        _ownFleetMissAnimMinUntil.Clear();
        if (msg.MyOutgoing is not null)
        {
            foreach (var s in msg.MyOutgoing)
            {
                _enemyIntel[(s.X, s.Y)] = s.Result;
                ApplySettledFxForIntelCell(s.X, s.Y, s.Result, onTargetGrid: true);
            }
        }

        if (msg.IncomingOnOwn is not null)
        {
            foreach (var s in msg.IncomingOnOwn)
            {
                _incomingOnOwn[(s.X, s.Y)] = s.Result;
                ApplySettledFxForIntelCell(s.X, s.Y, s.Result, onTargetGrid: false);
            }
        }

        ApplyOwnFleetCellsFromSnapshot(msg.OwnFleet);

        if (msg.Placements is { Count: > 0 })
        {
            _placementOrder.Clear();
            _placementOrder.AddRange(msg.Placements);
        }
        else if (msg.OwnFleet is { Count: > 0 })
            TryReconstructPlacementsFromOwnFleet(msg.OwnFleet);

        _shotClockDeadlineUtc = msg.ShotClockDeadlineUtc != default
            ? msg.ShotClockDeadlineUtc
            : DateTimeOffset.UtcNow.AddSeconds(15);
        RebuildPlacementCellMap();
        StartShotClockCountdown();
    }

    void ResetShotUiTicker()
    {
        try
        {
            _shotUiCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        try
        {
            _shotUiCts?.Dispose();
        }
        catch (ObjectDisposedException)
        {
        }

        _shotUiCts = null;
    }

    void StartShotClockCountdown()
    {
        ResetShotUiTicker();
        if (!_inBattle || _postMatchPhase)
            return;
        _shotUiCts = new CancellationTokenSource();
        _ = RunShotClockUiTicker(_shotUiCts.Token);
    }

    async Task RunShotClockUiTicker(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested && _inBattle && !_postMatchPhase)
            {
                await Task.Delay(250, ct);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // ignore
        }
    }

    async Task ConfirmLeaveMatchAsync()
    {
        bool ok;
        try
        {
            ok = await JS.InvokeAsync<bool>("battleGridMatchGuard.confirmLeave");
        }
        catch
        {
            ok = false;
        }

        if (!ok)
            return;

        try
        {
            if (_hub is not null && _hub.State == HubConnectionState.Connected)
                await _hub.InvokeAsync("ForfeitMatch", "AbandonShip");
            else
            {
                lastEvent = "Not connected - cannot abandon right now.";
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch
        {
            lastEvent = "Could not abandon match. Check your connection.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        ResetShotUiTicker();

        if (!_postMatchPhase)
            await TryApplyMatchRecoveryFromApiAsync();

        if (!_postMatchPhase)
        {
            for (var i = 0; i < 15 && !_postMatchPhase; i++)
                await Task.Delay(100);
        }

        if (!_postMatchPhase)
        {
            await LeaveMatchUiAsync();
            Nav.NavigateTo("/dashboard");
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    void StartPostMatchCountdown()
    {
        _postMatchUiCts?.Cancel();
        _postMatchUiCts?.Dispose();
        _postMatchUiCts = new CancellationTokenSource();
        _ = RunPostMatchUiTicker(_postMatchUiCts.Token);
    }

    async Task RunPostMatchUiTicker(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested && _postMatchPhase && _postMatchDeadlineUtc is { } d && DateTimeOffset.UtcNow < d)
            {
                await Task.Delay(500, ct);
                await InvokeAsync(StateHasChanged);
            }

            if (ct.IsCancellationRequested || !_postMatchPhase)
                return;

            await InvokeAsync(async () =>
            {
                _postMatchPhase = false;
                await LeaveMatchUiAsync();
                Nav.NavigateTo("/dashboard");
            });
        }
        catch (TaskCanceledException)
        {
            // ignore
        }
    }

    async Task GoDashboardAsync()
    {
        _postMatchUiCts?.Cancel();
        _postMatchPhase = false;
        ResetShotUiTicker();
        await LeaveMatchUiAsync();
        Nav.NavigateTo("/dashboard");
    }

    async Task LeaveMatchUiAsync()
    {
        MatchSession.LeaveMatch();
        try
        {
            await JS.InvokeVoidAsync("battleGridMatchGuard.setActive", false);
        }
        catch
        {
            // ignore
        }

        await Resumable.RefreshAsync();
    }

    void OnAuthChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (Auth.IsInitialized && (!Auth.IsLoggedIn || string.IsNullOrEmpty(Auth.AccessToken)))
                Nav.NavigateTo("/login");
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    public async ValueTask DisposeAsync()
    {
        Auth.OnChange -= OnAuthChanged;
        try
        {
            _placementUiCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _placementUiCts?.Dispose();
        _placementUiCts = null;
        try
        {
            _draftSyncCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _draftSyncCts?.Dispose();
        _draftSyncCts = null;
        try
        {
            _postMatchUiCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _postMatchUiCts?.Dispose();
        _postMatchUiCts = null;
        ResetShotUiTicker();
        await LeaveMatchUiAsync();

        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}