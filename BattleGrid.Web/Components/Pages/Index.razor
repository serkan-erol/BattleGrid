@page "/"
@implements IDisposable
@inject ApiService Api
@inject AuthStateService Auth
@inject QueueMatchmakingService Matchmaking
@inject ResumableMatchService Resumable

<PageTitle>BattleGrid - Command Center</PageTitle>

<div class="hero">
    <div class="hero-content">
        <div class="hero-badge">NAVAL COMMAND SYSTEM v1.0</div>
        <h1 class="hero-title">BATTLE<span class="accent">GRID</span></h1>
        <p class="hero-subtitle">Multiplayer Battleship Strategy Platform</p>
        <div class="hero-actions">
            @if (Auth.IsLoggedIn)
            {
                @if (Resumable.HasResumableMatch && Resumable.MatchId is int mid)
                {
                    <a href="/game/@mid" class="btn btn-primary btn-lg">REJOIN MATCH #@mid</a>
                }
                else
                {
                    <a href="/queue" class="btn btn-primary btn-lg">
                        @(Matchmaking.IsInQueue ? "IN QUEUE" : "FIND A MATCH")
                        @if (Matchmaking.IsInQueue && Matchmaking.QueueStartedUtc is not null)
                        {
                            <span class="nav-queue-timer">@QueueMatchmakingService.FormatWaitClock(Matchmaking.GetQueueElapsed())</span>
                        }
                    </a>
                }
                <a href="/dashboard" class="btn btn-outline btn-lg">DASHBOARD</a>
            }
            else
            {
                <a href="/register" class="btn btn-primary btn-lg">REGISTER OPERATOR</a>
                <a href="/login" class="btn btn-outline btn-lg">LOGIN</a>
            }
        </div>
    </div>
</div>

<div class="section">
    <h2 class="section-title"><span class="accent">◈</span> SYSTEM STATUS</h2>
    <div class="cards-grid">
        <div class="card @(apiOnline ? "card-success" : "card-danger")">
            <div class="card-header">
                <span class="card-icon">⬡</span>
                <span class="card-label">API STATUS</span>
            </div>
            <div class="card-body">
                @if (statusLoading)
                {
                    <span class="muted">Pinging...</span>
                }
                else
                {
                    <span class="status-badge @(apiOnline ? "online" : "offline")">
                        @(apiOnline ? "● ONLINE" : "● OFFLINE")
                    </span>
                    <p class="muted mt-sm">@GetApiStatusMessage()</p>
                }
            </div>
        </div>

        <div class="card @(Auth.IsLoggedIn ? "card-success" : "card")">
            <div class="card-header">
                <span class="card-icon">◉</span>
                <span class="card-label">OPERATOR</span>
            </div>
            <div class="card-body">
                @if (!Auth.IsInitialized)
                {
                    <span class="muted">Checking session…</span>
                }
                else if (Auth.IsLoggedIn)
                {
                    <span class="status-badge online">● AUTHENTICATED</span>
                    <p class="muted mt-sm">@(string.IsNullOrWhiteSpace(Auth.CurrentUser?.UserName) ? "-" : Auth.CurrentUser!.UserName)</p>
                    <p class="muted mt-sm">@GetOperatorLoggedInMessage()</p>
                }
                else
                {
                    <span class="status-badge offline">● NOT LOGGED IN</span>
                    <p class="muted mt-sm">@GetOperatorLoggedOutMessage()</p>
                }
            </div>
        </div>

        <div class="card @GetDatabaseCardClass()">
            <div class="card-header">
                <span class="card-icon">⬢</span>
                <span class="card-label">DATABASE</span>
            </div>
            <div class="card-body">
                @if (statusLoading)
                {
                    <span class="muted">Pinging...</span>
                }
                else
                {
                    <span class="status-badge @GetDatabaseBadgeClass()">@GetDatabaseBadgeLabel()</span>
                    <p class="muted mt-sm">@GetDatabaseStatusMessage()</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    const string TechnicalIssuesMessage = "Some systems are experiencing technical issues. Please try again later";

    bool statusLoading = true;
    bool apiOnline;
    bool? dbOnline;
    bool _initialized;

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChanged;
        Matchmaking.OnStateChanged += OnMatchmakingChanged;
        Resumable.OnChange += OnResumableChanged;
    }

    void OnAuthChanged() => InvokeAsync(StateHasChanged);

    void OnMatchmakingChanged() => InvokeAsync(StateHasChanged);

    void OnResumableChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;
        await Auth.InitializeAsync();
        if (Auth.IsLoggedIn)
            await Resumable.RefreshAsync();

        var health = await Api.CheckSystemHealthAsync();
        apiOnline = health.ApiOnline;
        dbOnline = health.DatabaseOnline;
        statusLoading = false;
        StateHasChanged();
    }

    string GetApiStatusMessage() =>
        apiOnline
            ? "API responding. Secure connection established."
            : TechnicalIssuesMessage;

    string GetOperatorLoggedInMessage() =>
        SystemsHealthy()
            ? "All systems operational"
            : TechnicalIssuesMessage;

    string GetOperatorLoggedOutMessage() =>
        SystemsHealthy()
            ? "Login to access full system"
            : TechnicalIssuesMessage;

    bool SystemsHealthy() => apiOnline && dbOnline == true;

    string GetDatabaseCardClass()
    {
        if (statusLoading || !apiOnline || dbOnline != true)
            return "card-danger";
        return "card-success";
    }

    string GetDatabaseBadgeClass()
    {
        if (!apiOnline || dbOnline != true)
            return "offline";
        return "online";
    }

    string GetDatabaseBadgeLabel()
    {
        if (!apiOnline)
            return "● UNAVAILABLE";
        if (dbOnline == true)
            return "● CONNECTED";
        return "● UNREACHABLE";
    }

    string GetDatabaseStatusMessage()
    {
        if (!apiOnline)
            return TechnicalIssuesMessage;
        if (dbOnline == true)
            return "System data is safe and secure";
        return "Database connection could not be established!";
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChanged;
        Matchmaking.OnStateChanged -= OnMatchmakingChanged;
        Resumable.OnChange -= OnResumableChanged;
    }
}