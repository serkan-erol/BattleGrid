@page "/register"
@implements IDisposable
@inject ApiService Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Register - BattleGrid</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="loading-screen">
        <p class="muted">Restoring session...</p>
    </div>
}
else if (Auth.IsLoggedIn)
{
    <div class="loading-screen">
        <p class="muted">Redirecting to dashboard...</p>
    </div>
}
else
{
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon">⬡</div>
                <h1>REGISTER OPERATOR</h1>
                <p class="muted">Create your BattleGrid account</p>
            </div>

            @if (success)
            {
                <div class="alert alert-success">
                    <span>✔</span> Registration successful! <a href="/login" class="link">Login here</a>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        <span>✘</span> @errorMessage
                    </div>
                }

                <EditForm Model="model" OnValidSubmit="HandleRegister">
                    <div class="form-group">
                        <label class="form-label">USERNAME <span class="required">*</span></label>
                        <input class="form-control" placeholder="Letters, numbers, and underscores only" @bind="model.UserName" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">EMAIL <span class="required">*</span></label>
                        <input class="form-control" type="email" placeholder="operator@fleet.com" @bind="model.Email" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">PASSWORD <span class="required">*</span></label>
                        <input class="form-control" type="password" placeholder="••••••••" @bind="model.Password" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">CONFIRM PASSWORD <span class="required">*</span></label>
                        <input class="form-control" type="password" placeholder="•••••••••" @bind="model.ConfirmPassword" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-full" disabled="@loading">
                        @if (loading)
                        {
                            <span>PROCESSING...</span>
                        }
                        else
                        {
                            <span>REGISTER</span>
                        }
                    </button>
                </EditForm>

                <div class="auth-footer">
                    <p class="muted">Already registered? <a href="/login" class="link">Login here</a></p>
                </div>
            }        
        </div>
    </div>
}

@code {
    RegisterRequestDto model = new();
    string errorMessage = string.Empty;
    bool loading = false;
    bool success = false;

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Auth.InitializeAsync();
        if (Auth.IsLoggedIn)
            Nav.NavigateTo("/dashboard", replace: true);

        await InvokeAsync(StateHasChanged);
    }

    async Task HandleRegister()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(model.UserName))
        {
            errorMessage = "User name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.Email))
        {
            errorMessage = "Email is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.Password))
        {
            errorMessage = "Password is required.";
            return;
        }
        if (model.Password != model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        loading = true;
        var (ok, message) = await Api.RegisterAsync(model);
        loading = false;

        if (ok)
        {
            success = true;
        }
        else
        {
            errorMessage = message;
        }
    }

    void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.OnChange -= OnAuthChanged;
}
