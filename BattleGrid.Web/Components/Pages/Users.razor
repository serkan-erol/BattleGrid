@page "/users"
@implements IAsyncDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject ApiService Api

<PageTitle>Personnel - BattleGrid</PageTitle>

@if (!Auth.IsInitialized)
{
    <div class="loading-screen">
        <p class="muted">Restoring session...</p>
    </div>
}
else if (!Auth.IsLoggedIn)
{
    <div class="loading-screen">
        <p class="muted">Redirecting to login...</p>
    </div>
}
else if (Auth.CurrentUser?.IsAdmin != true)
{
    <div class="page-header">
        <h1><span class="accent">◈</span> ACCESS DENIED</h1>
    </div>
    <div class="alert alert-danger">
        <span>✘</span> Administrator privileges are required to view this page.
    </div>
    <a href="/dashboard" class="btn btn-outline mt-sm">Back to dashboard</a>
}
else
{
    <div class="page-header">
        <h1><span class="accent">◈</span> PERSONNEL DATABASE</h1>
        <p class="muted">All registered operators in the system</p>
    </div>

    @if (loading)
    {
        <div class="loading-state">
            <div class="radar-ping"></div>
            <p class="muted">Fetching personnel records...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <span>✘</span> @errorMessage
        </div>
    }
    else if (users == null || users.Count == 0)
    {
        <div class="alert alert-info">No operators found in database.</div>
    }
    else
    {
        <div class="table-toolbar">
            <span class="muted">@GetRangeLabel()</span>
            <button class="btn btn-outline btn-sm" @onclick="Reload" disabled="@loading">↻ REFRESH</button>
        </div>

        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>USERNAME</th>
                        <th>EMAIL</th>
                        <th>ROLE</th>
                        <th>STATUS</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr class="@UserAccountStatusHelper.GetDataTableRowClass(user)">
                            <td class="cell-id">#@user.UserID</td>
                            <td>@user.UserName</td>
                            <td class="cell-email">@user.Email</td>
                            <td>
                                @if (user.IsAdmin)
                                {
                                    <span class="badge badge-admin">ADMIN</span>
                                }
                                else
                                {
                                    <span class="badge badge-player">PLAYER</span>
                                }
                            </td>
                            <td>
                                <OperatorAccountStatus User="user" />
                            </td>
                            <td class="user-profile-link-cell">
                                <a href="/users/@user.UserID" class="btn btn-sm btn-outline">PROFILE</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="table-pagination">
                <button type="button"
                        class="btn btn-outline btn-sm"
                        disabled="@(currentPage <= 1 || loading)"
                        @onclick="GoToPreviousPage">
                    ← PREVIOUS
                </button>
                <span class="table-pagination-meta muted">
                    Page @currentPage of @totalPages
                </span>
                <button type="button"
                        class="btn btn-outline btn-sm"
                        disabled="@(currentPage >= totalPages || loading)"
                        @onclick="GoToNextPage">
                    NEXT →
                </button>
            </div>
        }
    }
}

@code {
    const int PageSize = 20;

    List<UserResponseDto> users = [];
    int currentPage = 1;
    int totalPages;
    int totalCount;
    bool loading = true;
    string? errorMessage;
    bool _pageDataLoaded;

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _pageDataLoaded)
            return;

        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Auth.CurrentUser?.IsAdmin != true)
            return;

        if (_pageDataLoaded)
            return;

        _pageDataLoaded = true;
        await LoadUsers();
    }

    async Task LoadUsers()
    {
        loading = true;
        errorMessage = null;
        await InvokeAsync(StateHasChanged);

        var result = await Api.GetUsersPageAsync(currentPage, PageSize);
        if (result == null)
        {
            errorMessage = "Failed to load personnel data. Is the API running?";
            users = [];
            loading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        users = result.Items;
        currentPage = result.Page;
        totalPages = result.TotalPages;
        totalCount = result.TotalCount;
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task Reload()
    {
        await LoadUsers();
    }

    async Task GoToPreviousPage()
    {
        if (currentPage <= 1 || loading)
            return;

        currentPage--;
        await LoadUsers();
    }

    async Task GoToNextPage()
    {
        if (currentPage >= totalPages || loading)
            return;

        currentPage++;
        await LoadUsers();
    }

    string GetRangeLabel()
    {
        if (totalCount == 0)
            return "0 operator(s) on record";

        var start = (currentPage - 1) * PageSize + 1;
        var end = Math.Min(currentPage * PageSize, totalCount);
        return $"Showing {start}–{end} of {totalCount} operator(s)";
    }

    private async void OnAuthChanged()
    {
        await InvokeAsync(async () =>
        {
            if (Auth.IsInitialized && !Auth.IsLoggedIn)
            {
                Nav.NavigateTo("/login");
                return;
            }

            if (Auth.IsInitialized && Auth.IsLoggedIn && Auth.CurrentUser?.IsAdmin == true && !_pageDataLoaded)
            {
                _pageDataLoaded = true;
                await LoadUsers();
            }
            else
            {
                StateHasChanged();
            }
        });
    }

    public ValueTask DisposeAsync()
    {
        Auth.OnChange -= OnAuthChanged;
        return ValueTask.CompletedTask;
    }
}
